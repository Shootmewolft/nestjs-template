{
	"name": "nestjs-template",
	"version": "1.0.0",
	"description": "Scalable and maintainable NestJS template with PostgreSQL, Drizzle ORM, and Docker support.",
	"author": "Shootmewolft",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"dev": "nest start --watch",
		"debug": "nest start --debug --watch",
		"prod": "node dist/main",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check-types": "tsc --noEmit",
		"generate": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate",
		"push": "drizzle-kit generate && drizzle-kit migrate",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"docker:dev": "docker compose up -d",
		"docker:dev:down": "docker compose down",
		"docker:dev:logs": "docker compose logs -f api",
		"docker:prod": "docker compose -f docker-compose.yml up -d",
		"docker:prod:down": "docker compose -f docker-compose.yml down",
		"docker:db": "docker compose up -d postgres",
		"docker:db:down": "docker compose down postgres",
		"docker:logs": "docker compose logs -f api",
		"docker:build": "docker compose build",
		"docker:ps": "docker compose ps",
		"docker:generate": "docker compose exec api bun run generate",
		"docker:migrate": "docker compose exec api bun run migrate",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@nestjs/common": "^11.1.19",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.19",
		"@nestjs/platform-express": "^11.1.19",
		"@nestjs/swagger": "^11.4.2",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"csrf-csrf": "^4.0.3",
		"drizzle-orm": "^0.45.2",
		"helmet": "^8.1.0",
		"pg": "^8.20.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@nestjs/cli": "^11.0.21",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.0",
		"drizzle-kit": "^0.31.10",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jest": "^30.3.0",
		"lint-staged": "^16.4.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.7",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
