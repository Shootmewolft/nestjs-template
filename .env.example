NODE_ENV=development
PORT=3000

# Security — generate with: openssl rand -hex 32
CSRF_SECRET=change_me_to_a_random_string_of_at_least_32_characters

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change_me_at_least_32_chars_long_jwt_secret_here_xxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_at_least_32_chars_long_refresh_secret_xx
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs

# Docker Compose (only used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs
